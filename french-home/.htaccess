# Used by Hostinger (LiteSpeed/Apache) when this folder is the website root.
# GitHub Pages ignores this file.

DirectoryIndex index.html
ErrorDocument 404 /404.html

# Always check for a fresh copy of pages and content, so a newly published
# story (or the admin itself) never shows from an old cached copy.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
